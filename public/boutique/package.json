{
  "name": "boutique",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Utilise npm run check:all pour les garde-fous\" && exit 1",

    "bundle:css":         "node scripts/bundle-css.js",
    "bundle:css:watch":   "node scripts/bundle-css.js && echo 'Bundle OK — relancez après chaque modif CSS'",

    "bundle:js":          "node scripts/bundle-js.js",
    "bundle:js:dev":      "node scripts/bundle-js.js --dev",
    "bundle:js:watch":    "node scripts/bundle-js.js --dev --watch",

    "lint:css":           "stylelint \"css/*.css\" --ignore-path .stylelintignore",
    "lint:css:fix":       "stylelint \"css/*.css\" --fix",
    "lint:css:report":    "stylelint \"css/*.css\" --formatter json > stylelint-report.json || true",

    "audit:arch":         "node scripts/audit-boutique-arch.js",
    "audit:arch:live":    "node scripts/gen-boutique-arch-live.js",

    "check:html":         "node scripts/check-html-balance.js",
    "check:imports":      "node scripts/check-js-imports.js",
    "check:body-classes": "node scripts/check-body-classes.js",
    "check:cache":        "node scripts/check-cache-buster.js",
    "check:cache:fix":    "node scripts/check-cache-buster.js --fix",
    "check:cache:init":   "node scripts/check-cache-buster.js --init",
    "check:bundle":       "node scripts/check-js-bundle.js",

    "test:e2e":           "playwright test",
    "test:e2e:headed":    "playwright test --headed",
    "test:e2e:debug":     "playwright test --debug",

    "check:all":          "npm run check:html && npm run check:imports && npm run check:body-classes && npm run check:cache && npm run check:bundle && npm run audit:arch && npm run audit:arch:live && npm run test:e2e",
    "check:all:verbose":  "npm run check:html && npm run check:imports && npm run check:body-classes && npm run check:cache && npm run check:bundle && npm run audit:arch",

    "precommit":          "npm run check:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "esbuild": "^0.21.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
