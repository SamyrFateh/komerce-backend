{
  "name": "komerce-backend",
  "version": "10.6.1",
  "description": "Komerce — Backend API e-commerce diaspora comorienne",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "nodemon server.js",
    "arch:gen": "node scripts/generate-komerce-arch-graph.js",
    "arch:report": "npm run arch:gen && node scripts/arch-db-check.js --report",
    "arch:check": "npm run arch:gen && node scripts/arch-db-check.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:verbose": "jest --runInBand --forceExit --detectOpenHandles --verbose",
    "test:unit:v41": "jest tests/unit/shared-cart-v41-transitions.test.js --no-coverage",
    "check:wording:v41": "node public/boutique/scripts/check-group-wording.js --v41",
    "test:lot0": "npm run test:unit:v41 && node public/boutique/scripts/check-group-wording.js",
    "test:p0": "node scripts/p0-runtime-check.js",
    "seed": "node scripts/seed.js",
    "check:boutique": "node scripts/check-boutique.mjs",
    "analyze:boutique-css": "node scripts/analyze-boutique-css.mjs",
    "build": "node public/boutique/scripts/deploy-css.js && npm run css:guard",
    "boutique:audit": "node public/boutique/scripts/audit-boutique-arch.js",
    "boutique:arch": "node public/boutique/scripts/gen-boutique-arch-live.js",
    "arch:drift": "node scripts/arch-schema-drift-check.js",
    "arch:reconcile": "node scripts/arch-reconcile.js",
    "arch:reconcile:check": "node scripts/arch-reconcile.js --check",
    "arch:gate": "npm run arch:gen && node scripts/arch-db-check.js && node scripts/arch-schema-drift-check.js && node scripts/arch-header-sql-check.js",
    "arch:reconcile:write": "node scripts/arch-reconcile.js --write",
    "db:snapshot": "node scripts/db-snapshot.js",
    "db:sync": "npm run db:snapshot && npm run arch:reconcile:write && npm run arch:gate",
    "arch:headers-sql": "node scripts/arch-header-sql-check.js",
    "arch:enrich": "node scripts/enrich-komerce-arch-db-fields.js",
    "arch:enrich:write": "node scripts/enrich-komerce-arch-db-fields.js --write",
    "arch:doctrine": "node scripts/arch-doctrine-sanitize-check.js",
    "arch:doctrine:all": "node scripts/arch-doctrine-sanitize-check.js --all",
    "dashboards:360": "node scripts/gen-dashboards-360.js",
    "dashboards:360:check": "node scripts/gen-dashboards-360.js --check",
    "dashboards:360:save": "node scripts/gen-dashboards-360.js --save",
    "boutique:360": "node scripts/gen-boutique-360.js",
    "boutique:360:check": "node scripts/gen-boutique-360.js --check",
    "boutique:360:save": "node scripts/gen-boutique-360.js --save",
    "meta:graph": "node scripts/gen-meta-graph.js",
    "meta:graph:check": "node scripts/gen-meta-graph.js --check",
    "meta:graph:save": "node scripts/gen-meta-graph.js --save",
    "arch:360:all": "npm run arch:gen && npm run dashboards:360 && npm run boutique:360 && npm run meta:graph",
    "contract:generate": "node scripts/contract-generate.js",
    "security:360": "node scripts/gen-security-360.js",
    "security:360:check": "node scripts/gen-security-360.js --check",
    "security:360:save": "node scripts/gen-security-360.js --save",
    "backend:audit": "node scripts/audit-backend-arch.js",
    "sourcing:audit": "node scripts/audit-sourcing.js",
    "sourcing:audit:observe": "node scripts/audit-sourcing.js --observe",
    "backend:arch": "node scripts/gen-backend-arch-live.js",
    "pretest": "npm run backend:audit",
    "schema:check": "node scripts/check-schema-freshness.js",
    "audit:gate": "node scripts/npm-audit-gate.js",
    "audit:gate:observe": "node scripts/npm-audit-gate.js --observe",
    "db:check": "node scripts/check-schema-freshness.js",
    "quality:gate": "node scripts/code-quality-gate.js --strict",
    "quality:gate:report": "node scripts/code-quality-gate.js",
    "quality:gate:fix": "node scripts/code-quality-gate.js --fix",
    "feature:registry": "node scripts/feature-registry-check.js --strict",
    "feature:registry:report": "node scripts/feature-registry-check.js",
    "feature:registry:orphans": "node scripts/feature-registry-check.js --orphans",
    "feature:check": "node scripts/feature-guard.js --strict",
    "css:guard": "node public/boutique/scripts/css-guard.js --strict",
    "gate:touched-files": "node scripts/touched-files-feature-gate.js",
    "gate:schema": "node scripts/feature-schema-check.js --strict",
    "gate:schema:full": "node scripts/feature-schema-check.js --strict --full",
    "gate:feature-audit": "node scripts/feature-audit.js --strict",
    "gate:docs-lint": "node scripts/docs-history-lint.js --strict",
    "map:check": "node scripts/map-check.js",
    "map:check:verbose": "node scripts/map-check.js --verbose",
    "map:check:bail": "node scripts/map-check.js --bail"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^8.0.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.14.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "stripe": "^15.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
