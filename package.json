{
  "name": "komerce-backend",
  "version": "10.6.1",
  "description": "Komerce — Backend API e-commerce diaspora comorienne",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "nodemon server.js",
    "arch:gen": "node scripts/generate-komerce-arch-graph.js",
    "arch:report": "npm run arch:gen && node scripts/arch-db-check.js --report",
    "arch:check": "npm run arch:gen && node scripts/arch-db-check.js",
    "test": "jest --config jest.unit.config.js --runInBand --forceExit --detectOpenHandles",
    "test:verbose": "jest --config jest.unit.config.js --runInBand --forceExit --detectOpenHandles --verbose",
    "test:status": "node scripts/test-status.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:e2e:features": "node scripts/run-e2e-feature-tests.js",
    "test:e2e:feature": "node scripts/run-e2e-feature-tests.js",
    "test:e2e:lot": "node scripts/run-e2e-feature-tests.js",
    "test:unit:coverage": "jest --config jest.unit.config.js --ci --runInBand --coverage --forceExit --detectOpenHandles",
    "test:unit:v41": "jest tests/unit/shared-cart-v41-transitions.test.js --no-coverage",
    "check:wording:v41": "node public/boutique/scripts/check-group-wording.js --v41",
    "test:lot0": "npm run test:unit:v41 && node public/boutique/scripts/check-group-wording.js",
    "test:p0": "node scripts/p0-runtime-check.js",
    "seed": "node scripts/seed.js",
    "check:boutique": "node scripts/check-boutique.mjs",
    "analyze:boutique-css": "node scripts/analyze-boutique-css.mjs",
    "build": "node public/boutique/scripts/deploy-css.js && npm run css:guard && npm run css:specificity-guard",
    "boutique:audit": "node public/boutique/scripts/audit-boutique-arch.js",
    "boutique:arch": "node public/boutique/scripts/gen-boutique-arch-live.js",
    "arch:drift": "node scripts/arch-schema-drift-check.js",
    "arch:reconcile": "node scripts/arch-reconcile.js",
    "arch:reconcile:check": "node scripts/arch-reconcile.js --check",
    "arch:gate": "npm run arch:gen && node scripts/arch-db-check.js && node scripts/arch-schema-drift-check.js && node scripts/arch-header-sql-check.js && node scripts/check-schema-resurrection.js",
    "arch:reconcile:write": "node scripts/arch-reconcile.js --write",
    "schema:promote": "node scripts/schema-promote.js",
    "schema:promote:check": "node scripts/schema-promote.js --check",
    "schema:promote:write": "node scripts/schema-promote.js --write",
    "db:snapshot": "node scripts/db-snapshot.js",
    "db:sync": "npm run db:snapshot && npm run schema:promote:write && npm run arch:reconcile:write && npm run arch:gate",
    "arch:headers-sql": "node scripts/arch-header-sql-check.js",
    "arch:enrich": "node scripts/enrich-komerce-arch-db-fields.js",
    "arch:enrich:write": "node scripts/enrich-komerce-arch-db-fields.js --write",
    "arch:doctrine": "node scripts/arch-doctrine-sanitize-check.js",
    "arch:doctrine:all": "node scripts/arch-doctrine-sanitize-check.js --all",
    "dashboards:360": "node scripts/gen-dashboards-360.js",
    "dashboards:360:check": "node scripts/gen-dashboards-360.js --check",
    "dashboards:360:save": "node scripts/gen-dashboards-360.js --save",
    "boutique:360": "node scripts/gen-boutique-360.js",
    "boutique:360:check": "node scripts/gen-boutique-360.js --check",
    "boutique:360:save": "node scripts/gen-boutique-360.js --save",
    "business-graph:gen": "node scripts/business-graph-gen.js --dash-root public --boutique-root public/boutique",
    "business-graph:check": "node scripts/business-graph-gen.js --check --dash-root public --boutique-root public/boutique",
    "business-graph:ratchet-check": "node scripts/business-graph-ratchet-check.js",
    "business-graph:disposition-check": "node scripts/business-graph-disposition-check.js",
    "meta:graph": "node scripts/gen-meta-graph.js",
    "meta:graph:check": "node scripts/gen-meta-graph.js --check",
    "meta:graph:save": "node scripts/gen-meta-graph.js --save",
    "gate:findings:gen": "node scripts/gen-gate-findings.js",
    "agent:remediation:gen": "node scripts/gen-agent-remediation-index.js",
    "agent:remediation:check": "node scripts/check-agent-remediation-contract.js",
    "feature:360:gen": "node scripts/gen-feature-360.js",
    "feature:360:refresh-global": "npm run gate:findings:gen && npm run feature:360:gen",
    "feature:360:check": "node scripts/feature-360-check.js",
    "arch:360:all": "npm run arch:gen && npm run dashboards:360 && npm run boutique:360 && npm run meta:graph",
    "contract:generate": "node scripts/contract-generate.js && node scripts/contract-debt-sync.js --write",
    "security:360": "node scripts/run-security-360.js",
    "security:360:check": "node scripts/run-security-360.js --check",
    "security:360:save": "node scripts/run-security-360.js --save",
    "backend:audit": "node scripts/backend-audit.js",
    "gate:catalog-contract": "node scripts/gates/catalog-contract-gate.js",
    "alerts:contract:check": "node scripts/alerts-contract-check.js",
    "sourcing:audit": "node scripts/audit-sourcing.js",
    "sourcing:audit:observe": "node scripts/audit-sourcing.js --observe",
    "backend:arch": "node scripts/gen-backend-arch-live.js",
    "backend:debt": "node scripts/debt-audit.js",
    "pretest": "npm run backend:audit && npm run testkit:headers",
    "check:sku-coverage": "node scripts/check-sku-coverage.js",
    "check:sku-coverage:json": "node scripts/check-sku-coverage.js --json",
    "check:sku-coverage:strict": "node scripts/check-sku-coverage.js --strict",
    "schema:check": "node scripts/check-schema-freshness.js",
    "schema:check:resurrection": "node scripts/check-schema-resurrection.js",
    "audit:gate": "node scripts/npm-audit-gate.js",
    "audit:gate:observe": "node scripts/npm-audit-gate.js --observe",
    "testkit:check": "node scripts/test-kit-usage-check.js --strict",
    "testkit:check:report": "node scripts/test-kit-usage-check.js --report",
    "testkit:headers": "node scripts/test-header-check.js --strict",
    "testkit:headers:report": "node scripts/test-header-check.js",
    "db:check": "node scripts/check-schema-freshness.js",
    "quality:gate": "node scripts/code-quality-gate.js --strict",
    "quality:gate:report": "node scripts/code-quality-gate.js",
    "quality:gate:fix": "node scripts/code-quality-gate.js --fix",
    "feature:registry": "node scripts/feature-registry-check.js --strict",
    "feature:registry:report": "node scripts/feature-registry-check.js",
    "feature:registry:orphans": "node scripts/feature-registry-check.js --orphans",
    "feature:registry-doc": "node scripts/registry-doc-check.js --strict",
    "feature:registry-doc:report": "node scripts/registry-doc-check.js",
    "feature:check": "node scripts/feature-guard.js --strict",
    "feature:classification": "node scripts/feature-classification-check.js",
    "feature:classification:strict": "node scripts/feature-classification-check.js --strict",
    "feature:classification:json": "node scripts/feature-classification-check.js --json",
    "css:guard": "node public/boutique/scripts/css-guard.js --strict",
    "css:specificity-guard": "node public/boutique/scripts/css-specificity-guard.js --strict",
    "gate:touched-files": "node scripts/touched-files-feature-gate.js",
    "gate:schema": "node scripts/feature-schema-check.js --strict --full",
    "gate:schema:full": "node scripts/feature-schema-check.js --strict --full",
    "gate:schema:save": "node scripts/feature-schema-check.js --save",
    "gate:feature-audit": "node scripts/feature-audit.js --strict",
    "gate:docs-lint": "node scripts/docs-history-lint.js --strict --full",
    "gate:docs-lint:full": "node scripts/docs-history-lint.js --strict --full",
    "gate:docs-lint:save": "node scripts/docs-history-lint.js --save",
    "gate:boutique-ownership": "node scripts/boutique-ownership-check.js",
    "gate:boutique-ownership:full": "node scripts/boutique-ownership-full-check.js --strict",
    "gate:concept-impact": "node scripts/concept-impact-gate.js",
    "map:check": "npm run gate:concept-impact && npm run alerts:contract:check && node scripts/map-check.js",
    "map:check:verbose": "node scripts/map-check.js --verbose",
    "map:check:bail": "node scripts/map-check.js --bail",
    "gate:pr-governance": "node scripts/pr-governance-check.js",
    "gate:touched-tests": "node scripts/touched-tests-gate.js",
    "gate:touched-tests:report": "node scripts/touched-tests-gate.js --report",
    "predeploy": "node scripts/predeploy-gate.js",
    "predeploy:report": "node scripts/predeploy-gate.js --report",
    "predeploy:skip-tests": "node scripts/predeploy-gate.js --skip-tests",
    "prepare": "node scripts/setup-hooks-runner.js",
    "hooks:install": "node scripts/setup-hooks-runner.js",
    "feature:invariant:check": "node scripts/feature-invariant-check.js",
    "feature:invariant:check:strict": "node scripts/feature-invariant-check.js --strict",
    "contract:debt:check": "node scripts/contract-debt-sync.js --check",
    "contract:debt:write": "node scripts/contract-debt-sync.js --write",
    "impact:suppressions:check": "node scripts/impact-suppression-check.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^8.0.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.14.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "stripe": "^15.11.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "jest": "^30.5.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "test-exclude": "8.0.0",
    "qs": "6.16.0"
  }
}
