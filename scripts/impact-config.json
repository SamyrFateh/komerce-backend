  "securityPatterns": {
    "sqlInjection": {
      "patterns": [
        "\\$\\{.*\\}.*(?:SELECT|INSERT|UPDATE|DELETE|DROP|ALTER|CREATE|TRUNCATE)",
        "\\+\\s*(?:req\\.|params\\.|query\\.|body\\.).*(?:SELECT|INSERT|UPDATE|DELETE)",
        "[`'\"]\\s*\\+\\s*(?:req\\.|params\\.|query\\.|body\\.)",
        "(?:query|exec)\\s*\\(\\s*[`'\"].*\\$\\{",
        "\\w+\\.query\\s*\\(\\s*[`'\"].*\\+\\s*(?:req|params|query|body)"
      ],
      "severity": "critical",
      "score": 25
    },
    "xss": {
      "patterns": [
        "innerHTML\\s*=",
        "document\\.write\\(",
        "res\\.send\\(.*req\\.(body|query|params)",
        "\\$\\{.*req\\.(body|query|params).*\\}.*<"
      ],
      "severity": "critical",
      "score": 20
    },
    "hardcodedSecrets": {
      "patterns": [
        "(?:password|secret|key|token|api_key)\\s*[:=]\\s*['\"][^'\"]{8,}['\"]",
        "(?:STRIPE_|JWT_|SMS_|DB_|SMTP_)\\w+\\s*[:=]\\s*['\"][^'\"]+['\"]",
        "Bearer\\s+[A-Za-z0-9\\-._~+/]+=*"
      ],
      "severity": "critical",
      "score": 25
    },
    "dangerousOps": {
      "patterns": [
        "DROP\\s+(?:TABLE|DATABASE|INDEX|SCHEMA)",
        "TRUNCATE\\s+",
        "DELETE\\s+FROM\\s+\\w+\\s*(?:;|$)",
        "ALTER\\s+TABLE.*DROP\\s+COLUMN",
        "eval\\s*\\(",
        "child_process",
        "exec\\s*\\(",
        "rm\\s+-rf"
      ],
      "severity": "high",
      "score": 15
    },
    "missingAuth": {
      "patterns": [
        "router\\.(?:get|post|put|patch|delete)\\s*\\([^)]*(?!auth|verify|check)[^)]*,\\s*(?:async\\s+)?\\(req"
      ],
      "severity": "medium",
      "score": 10
    },
    "unsafeFileOps": {
      "patterns": [
        "fs\\.(?:writeFile|unlink|rmdir|rename)\\s*\\(",
        "path\\.join\\s*\\(.*req\\."
      ],
      "severity": "high",
      "score": 15
    }
  },
