#!/bin/sh
# KOMERCE-HOOK pre-push-stamp v3
# Prévol rapide pour publication de branche PR ; tampon intégral pour main/tags.
# Aucun de ces tampons locaux ne remplace le verdict CI obligatoire.
STAMP="$(git rev-parse --git-path komerce-preflight-green)"
GREEN=""
[ -f "$STAMP" ] && GREEN="$(cat "$STAMP")"
READY_STAMP="$(git rev-parse --git-path komerce-preflight-ready)"
READY=""
[ -f "$READY_STAMP" ] && READY="$(cat "$READY_STAMP")"
ZERO="0000000000000000000000000000000000000000"
STATUS=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "$LOCAL_SHA" ] && continue
  [ "$LOCAL_SHA" = "$ZERO" ] && continue
  # wip/* : sauvegardes de sandbox (scripts/agent-checkpoint.js), sans CI ni PR.
  case "$REMOTE_REF" in refs/heads/wip/*) continue ;; esac
  [ "$LOCAL_SHA" = "$GREEN" ] && continue
  case "$REMOTE_REF" in
    refs/heads/main|refs/heads/master|refs/tags/*) COMMAND="npm run pr:preflight" ;;
    refs/heads/*) [ "$LOCAL_SHA" = "$READY" ] && continue; COMMAND="npm run pr:preflight -- --quick" ;;
    *) COMMAND="npm run pr:preflight" ;;
  esac
  echo "✖ pre-push Komerce : $LOCAL_REF ($LOCAL_SHA) n'a pas de tampon de publication valide."
  echo "  Lancer : $COMMAND (arbre propre, sur le commit à pousser)"
  STATUS=1
done
exit $STATUS
