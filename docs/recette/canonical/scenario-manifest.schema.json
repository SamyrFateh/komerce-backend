{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "komerce-g6-scenario-manifest/1",
  "title": "Komerce G6 scenario manifest (binding only, matrix is the business authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario_id",
    "matrix_ref",
    "market_options",
    "cohort_options",
    "configuration",
    "expected_oracle_ids",
    "binding_status"
  ],
  "properties": {
    "schema": {
      "const": "komerce-g6-scenario-manifest/1"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^(M0[1-6]|N(0[1-9]|[1-3][0-9]|40))$"
    },
    "matrix_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "id",
        "version"
      ],
      "properties": {
        "path": {
          "const": "docs/recette/G6_PRE_STRESS_BUSINESS_SCENARIOS.json"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "market_options": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "KM",
          "CM",
          "CG"
        ]
      }
    },
    "cohort_options": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GPT-G6",
          "CLAUDE-PAR"
        ]
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "cohort",
        "basket",
        "payment",
        "steps",
        "branches"
      ],
      "properties": {
        "market": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "KM",
            "CM",
            "CG"
          ]
        },
        "cohort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "GPT-G6",
            "CLAUDE-PAR"
          ]
        },
        "basket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "lines"
          ],
          "properties": {
            "source": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "import",
                "local",
                "mixed"
              ]
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "payment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "simulated_only"
          ],
          "properties": {
            "method": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "cash_relais",
                "mobile_money"
              ]
            },
            "simulated_only": {
              "const": true
            }
          }
        },
        "steps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        },
        "branches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        }
      }
    },
    "expected_oracle_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "binding_status": {
      "enum": [
        "NOT_BOUND",
        "GOLDEN_EVIDENCE_ONLY",
        "READY_FOR_REVIEW"
      ]
    },
    "historical_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "artifact_id",
        "order_ref",
        "order_status",
        "replay_forbidden"
      ],
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_id": {
          "type": "integer",
          "minimum": 1
        },
        "order_ref": {
          "type": "string"
        },
        "order_status": {
          "const": "collected"
        },
        "replay_forbidden": {
          "const": true
        }
      }
    }
  }
}
