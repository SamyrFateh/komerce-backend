{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "komerce-g6-scenario-manifest/1",
  "title": "Komerce G6 scenario manifest (binding only, matrix is the business authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario_id",
    "matrix_ref",
    "market_options",
    "cohort_options",
    "configuration",
    "expected_oracle_ids",
    "binding_status"
  ],
  "properties": {
    "schema": {
      "const": "komerce-g6-scenario-manifest/1"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^(M0[1-6]|N(0[1-9]|[1-3][0-9]|40))$"
    },
    "matrix_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "id",
        "version"
      ],
      "properties": {
        "path": {
          "const": "docs/recette/G6_PRE_STRESS_BUSINESS_SCENARIOS.json"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "market_options": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "KM",
          "CM",
          "CG"
        ]
      }
    },
    "cohort_options": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GPT-G6",
          "CLAUDE-PAR"
        ]
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "cohort",
        "basket",
        "payment",
        "steps",
        "branches"
      ],
      "properties": {
        "market": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "KM",
            "CM",
            "CG"
          ]
        },
        "cohort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "GPT-G6",
            "CLAUDE-PAR"
          ]
        },
        "basket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "lines"
          ],
          "properties": {
            "source": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "import",
                "local",
                "mixed"
              ]
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "payment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "simulated_only"
          ],
          "properties": {
            "method": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "cash_relais",
                "mobile_money"
              ]
            },
            "simulated_only": {
              "const": true
            }
          }
        },
        "steps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        },
        "branches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        }
      }
    },
    "fixture_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provenance",
        "market",
        "product",
        "buyer_order",
        "commitment",
        "manual_purchase_capture",
        "supplier_payment_authorization",
        "external_effects",
        "blocking_capabilities"
      ],
      "properties": {
        "status": { "const": "PREPARED_BLOCKED" },
        "provenance": { "const": "SIMULATED / STAGING ONLY" },
        "market": { "const": "KM" },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture_ref", "product_ref", "source_kind", "supplier_system_key", "internal_sku", "physical_stock", "sellable_status"],
          "properties": {
            "fixture_ref": { "const": "G6-M06-KM" },
            "product_ref": { "const": "KPR-000255" },
            "source_kind": { "const": "central_hub_manual" },
            "supplier_system_key": { "const": "central_hub" },
            "internal_sku": { "const": "generated_unique_per_run" },
            "physical_stock": { "const": 0 },
            "sellable_status": { "const": "ON_ORDER" }
          }
        },
        "buyer_order": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantity", "payment_method", "payment_simulated_only", "procure_on_order"],
          "properties": {
            "quantity": { "const": 3 },
            "payment_method": { "const": "cash_relais" },
            "payment_simulated_only": { "const": true },
            "procure_on_order": { "const": true }
          }
        },
        "commitment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency", "proof_ref", "indicative_budget_is_not_confirmed_cost"],
          "properties": {
            "amount": { "const": 30 },
            "currency": { "const": "EUR" },
            "proof_ref": { "const": "SIM-M06-COMMITMENT-<run_id>" },
            "indicative_budget_is_not_confirmed_cost": { "const": true }
          }
        },
        "manual_purchase_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allocations", "seller_identity_source", "confirmed_price_source", "proof_required", "synthetic_seller_or_price_values", "allocation_must_cover_order_quantity"],
          "properties": {
            "allocations": { "const": "captured_in_canonical_ui_at_purchase_time" },
            "seller_identity_source": { "const": "actual_seller_entered_by_operator" },
            "confirmed_price_source": { "const": "price_confirmed_at_purchase" },
            "proof_required": { "const": true },
            "synthetic_seller_or_price_values": { "const": false },
            "allocation_must_cover_order_quantity": { "const": true }
          }
        },
        "supplier_payment_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount_source", "currency", "proof_ref_source", "separate_from_commitment", "external_debit"],
          "properties": {
            "amount_source": { "const": "confirmed_manual_purchase_totals" },
            "currency": { "const": "EUR" },
            "proof_ref_source": { "const": "captured_in_canonical_ui" },
            "separate_from_commitment": { "const": true },
            "external_debit": { "const": false }
          }
        },
        "external_effects": { "const": false },
        "blocking_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "expected_oracle_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "binding_status": {
      "enum": [
        "NOT_BOUND",
        "GOLDEN_EVIDENCE_ONLY",
        "READY_FOR_REVIEW"
      ]
    },
    "historical_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "artifact_id",
        "order_ref",
        "order_status",
        "replay_forbidden"
      ],
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_id": {
          "type": "integer",
          "minimum": 1
        },
        "order_ref": {
          "type": "string"
        },
        "order_status": {
          "const": "collected"
        },
        "replay_forbidden": {
          "const": true
        }
      }
    }
  }
}
