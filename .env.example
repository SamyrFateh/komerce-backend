# KOMERCE — Variables d'environnement
# Copier en .env et remplir les valeurs réelles

# ── Serveur ───────────────────────────────────────────────────
NODE_ENV=development
# Identité métier du runtime. Ne jamais la déduire du domaine :
# komerce.co est staging avant go-live et peut devenir production ensuite.
# Valeurs autorisées : development | test | staging | production
KOMERCE_ENV=development
PORT=3000

# ── Boot / diagnostic (bootstrap/boot-guard.js, bootstrap/server-lifecycle.js) ─
# true : désactive les crons opérationnels au boot (utile pour isoler un
# diagnostic, ex. fuite de pool DB, sans le bruit des crons en tâche de fond)
KOMERCE_DISABLE_CRONS=false
# true : saute runStartupMigrations (fixAdminHash/fixMissingSchema/runAllSeeds)
# au boot — utile pour un redémarrage rapide en diagnostic uniquement
KOMERCE_SKIP_STARTUP_MIGRATIONS=false
# true : saute ensureRoutingColumns/ensureSecurityTables au boot (ensureWalletTables
# reste actif, 31ms, sans risque). Incident 2026-07-09 : ces deux étapes peuvent
# entrer en contention avec du trafic live et immobiliser le pool DB au démarrage.
# Le schéma (ALTER TABLE / CREATE TABLE IF NOT EXISTS) est repris automatiquement
# au prochain boot sans ce flag. Le backfill de données, lui, ne tourne plus jamais
# au boot — voir scripts/backfill-boot-data.js à lancer manuellement hors trafic.
KOMERCE_SKIP_BOOT_ENSURE=false

# ── Base de données PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://komerce_user:komerce2026@localhost:5432/komerce

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_secret_min_32_chars_ici

# ── QR Code retrait ──────────────────────────────────────────
QR_SECRET=change_this_qr_secret_min_32_chars

# ── Africa's Talking (SMS) ────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=komerce
AT_SENDER_ID=Komerce

# ── Twilio (WhatsApp) ─────────────────────────────────────────
# Trouvez ces valeurs sur https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Numéro WhatsApp approuvé ex: whatsapp:+33XXXXXXXXX
# (sandbox Twilio = whatsapp:+14155238886, nécessite opt-in des destinataires)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Stripe (paiement diaspora EUR) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary (images produits + colis) ─────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Taux de change (fallback si pas de service externe) ──────
RATE_EUR_KMF=492
RATE_AED_KMF=138

# ── URLs frontends ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── WebAuthn / passkeys (AUTH-2) ────────────────────────────────
# rpID = nom de domaine SANS schéma/port (ex: komerce.shop). 'localhost' en dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Komerce
# Liste d'origines acceptées séparées par des virgules. Si absent, fallback sur FRONTEND_URL.
# WEBAUTHN_ORIGINS=https://komerce.shop,https://www.komerce.shop

# ── PayPal (paiement diaspora EUR + Pay-in-4 France) ───────────
# Migration 079 — REQUIRED en production
# Récupérer sur https://developer.paypal.com/dashboard/applications/
PAYPAL_CLIENT_ID=ASxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=ELxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook ID : créé dans Developer Dashboard > Webhooks
# Subscriber au minimum à : PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
#                          PAYMENT.CAPTURE.REFUNDED, CUSTOMER.DISPUTE.CREATED
PAYPAL_WEBHOOK_ID=8XX0000000000000X
# sandbox | production — DOIT être 'production' en prod (refus de boot sinon)
PAYPAL_ENV=sandbox

# ── Enrichissement catalogue IA (K-3, DOCTRINE_CATALOGUE §4/§8) ─
# Sans clé : l'import fonctionne, les fiches restent en donnée source
# (EN, connector_raw) et sont marquées needs_review — dégradation douce.
ANTHROPIC_API_KEY=
# Modèle d'enrichissement (défaut : claude-haiku-4-5 — coût/latence adaptés
# à une fiche produit ; monter en gamme se décide en PR, pas en console)
CATALOG_ENRICH_MODEL=claude-haiku-4-5

# ── Meta WhatsApp Business (webhook) ──────────────────────────
# Secret HMAC pour vérifier la signature X-Hub-Signature-256 des webhooks Meta.
# REQUIRED en production (P4-2) — refus de boot sinon, voir routes/meta-whatsapp.js
META_WA_APP_SECRET=change_this_meta_app_secret
META_WA_VERIFY_TOKEN=change_this_verify_token
